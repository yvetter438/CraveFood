{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/c/foodwishes/:recipeSlug", "destination": "/prototype1/index.html" },
    { "source": "/c/foodwishes", "destination": "/prototype1/index.html" },
    { "source": "/c/:slug", "destination": "/c/index.html?slug=:slug" },
    { "source": "/p/:id", "destination": "/p/index.html?id=:id" },
    {
      "source": "/prototype1/:path((?!assets/).*)",
      "destination": "/prototype1/index.html"
    }
  ]
}
